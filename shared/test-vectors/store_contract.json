  "purchase_item": {
    "method": "POST",
    "path": "/store/purchase",
    "request": {
      "itemId": "mint"
    },
    "response_200": {
      "status": 200,
      "body": {
        "success": true,
        "itemId": "mint",
        "coins": 150
      }
    },
    "response_402_not_enough_coins": {
      "status": 402,
      "body": {
        "error": "not_enough_coins",
        "message": "Yetersiz jeton",
        "coins": 50
      }
    },
    "response_400_already_owned": {
      "status": 400,
      "body": {
        "error": "already_owned",
        "message": "Bu çerçeveye zaten sahipsiniz"
      }
    },
    "response_400_invalid_item": {
      "status": 400,
      "body": {
        "error": "invalid_item",
        "message": "Geçersiz çerçeve öğesi"
      }
    },
    "response_400_unsupported_client_version": {
      "status": 400,
      "body": {
        "error": "unsupported_client_version",
        "message": "Bu çerçeveyi satın almak için uygulamanızı güncelleyin"
      }
    },
    "response_400_item_retired": {
      "status": 400,
      "body": {
        "error": "item_retired",
        "message": "Bu çerçeve emekliye ayrılmıştır ve artık satın alınamaz"
      }
    }
  },
  "equip_frame": {
    "method": "PUT",
    "path": "/me/frame",
    "request": {
      "frameId": "mint"
    },
    "request_client_payload": {
      "frameId": "mint",
      "frame": "mint"
    },
    "response_200": {
      "status": 200,
      "body": {
        "success": true,
        "equippedFrame": "mint"
      }
    },
    "response_400_item_not_owned": {
      "status": 400,
      "body": {
        "error": "item_not_owned",
        "message": "Bu çerçeveye sahip değilsiniz"
      }
    },
    "response_400_invalid_frame": {
      "status": 400,
      "body": {
        "error": "invalid_frame",
        "message": "Geçersiz çerçeve kimliği"
      }
    },
    "response_400_item_retired": {
      "status": 400,
      "body": {
        "error": "item_retired",
        "message": "Bu çerçeve emekliye ayrılmıştır ve kuşanılamaz"
      }
    }
  },
  "common_errors": {
    "response_401_unauthorized": {
      "status": 401,
      "body": {
        "error": "unauthorized"
      }
    },
    "response_410_account_deleted": {
      "status": 410,
      "body": {
        "error": "account_deleted",
        "message": "Hesap silinmiş"
      }
    },
    "response_500_internal_error": {
      "status": 500,
      "body": {
        "error": "internal_error",
        "message": "Durable Object error"
      }
    }
  }
}
